{
	"name": "clean-nest",
	"version": "0.0.1",
	"description": "",
	"author": "",
	"private": true,
	"license": "UNLICENSED",
	"scripts": {
		"build": "tsc --noEmit && nest build",
		"format": "prettier --write \"src/**/*.ts\" \"libs/**/*.ts\"",
		"start": "nest start",
		"start:dev": "nest start --watch",
		"start:debug": "nest start --debug --watch",
		"start:prod": "node dist/main",
		"lint": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
		"lint:fix": "eslint \"{src,apps,libs}/**/*.ts\" --fix",
		"lint:check": "eslint \"{src,apps,libs}/**/*.ts\"",
		"format:check": "prettier --check \"src/**/*.ts\" \"libs/**/*.ts\"",
		"typecheck": "tsc --noEmit",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"test:e2e": "jest --config ./test/jest-e2e.json",
		"prepare": "husky",
		"seed": "ts-node -r tsconfig-paths/register prisma/seed/index.ts",
		"seed:file": "ts-node -r tsconfig-paths/register prisma/seed/$FILE.ts",
		"dev": "NODE_OPTIONS='-r tsconfig-paths/register' nest start --watch"
	},
	"dependencies": {
		"@fastify/helmet": "^13.2.0",
		"@fastify/multipart": "^10.1.6",
		"@fastify/static": "10.1.8",
		"@keyv/redis": "^5.1.6",
		"@nestjs-modules/mailer": "^4.0.0",
		"@nestjs/bullmq": "12.0.0",
		"@nestjs/cache-manager": "12.0.2",
		"@nestjs/common": "12.3.2",
		"@nestjs/core": "12.3.2",
		"@nestjs/jwt": "12.0.3",
		"@nestjs/mapped-types": "12.0.0",
		"@nestjs/passport": "12.0.0",
		"@nestjs/platform-fastify": "12.3.2",
		"@nestjs/serve-static": "12.1.1",
		"@nestjs/swagger": "12.0.5",
		"@nestjs/terminus": "12.1.0",
		"@nestjs/throttler": "^6.7.1",
		"@prisma/adapter-pg": "^7.10.1",
		"@prisma/client": "^7.10.1",
		"@scalar/nestjs-api-reference": "^1.2.34",
		"bcryptjs": "^3.0.3",
		"bullmq": "^6.5.3",
		"cache-manager": "^7.2.9",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.15.1",
		"crypto-js": "^4.2.0",
		"dayjs": "^1.11.23",
		"envalid": "^9.0.0",
		"eslint-plugin-import": "^2.32.0",
		"fastify": "5.12.7",
		"handlebars": "^4.7.10",
		"ioredis": "^6.0.0",
		"jsonwebtoken": "^9.0.3",
		"keyv": "^5.6.0",
		"nestjs-i18n": "^10.8.5",
		"nodemailer": "^10.3.1",
		"passport": "^0.7.0",
		"passport-jwt": "^4.0.1",
		"passport-local": "^1.0.0",
		"pg": "^8.23.1",
		"reflect-metadata": "^0.2.2",
		"rxjs": "^7.8.2"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@nestjs/cli": "12.0.11",
		"@nestjs/schematics": "12.0.12",
		"@nestjs/testing": "12.3.2",
		"@rspack/core": "2.3.0",
		"@types/bun": "^1.4.4",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/multer": "^2.3.0",
		"@types/node": "^26.6.6",
		"@types/nodemailer": "^8.0.2",
		"@types/passport-local": "^1.0.38",
		"@types/pg": "^8.23.1",
		"@types/supertest": "^7.2.1",
		"dotenv": "^18.0.9",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-prettier": "^5.5.7",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"jest": "^30.5.2",
		"prettier": "^3.9.10",
		"prisma": "^7.10.1",
		"source-map-support": "^0.5.21",
		"supertest": "^7.3.1",
		"ts-jest": "^29.4.15",
		"ts-node": "^10.9.2",
		"tsconfig-paths": "^4.2.0",
		"tsconfig-paths-webpack-plugin": "^4.2.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"webpack-node-externals": "^3.0.0"
	},
	"jest": {
		"moduleFileExtensions": [
			"js",
			"json",
			"ts"
		],
		"rootDir": ".",
		"testRegex": ".*\\.spec\\.ts$",
		"transform": {
			"^.+\\.(t|j)s$": "ts-jest"
		},
		"collectCoverageFrom": [
			"**/*.(t|j)s"
		],
		"coverageDirectory": "./coverage",
		"testEnvironment": "node",
		"roots": [
			"<rootDir>/src/",
			"<rootDir>/libs/"
		],
		"moduleNameMapper": {
			"^@app/config(|/.*)$": "<rootDir>/libs/config/src/$1",
			"^@common(|/.*)$": "<rootDir>/libs/common/src/$1",
			"^@repositories/repositories(|/.*)$": "<rootDir>/libs/repositories/src/$1",
			"^@utils(|/.*)$": "<rootDir>/libs/utils/src/$1"
		}
	}
}
